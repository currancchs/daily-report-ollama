# Non-secret settings. This file is parsed, never executed as shell code.
AI_MONITOR_OLLAMA_URL=http://127.0.0.1:11434
AI_MONITOR_MODEL=qwen3:8b
AI_MONITOR_TIMEZONE=America/New_York
AI_MONITOR_HOME_NAS=home-nas.invalid
AI_MONITOR_WORK_NAS=work-nas.invalid
# Optional read-only mounts instead of SMB; each contains AI-Monitor-Exports/:
# AI_MONITOR_MOUNT_ROOT=/mnt/ai-monitor
# Optional wake settings; leave unset unless configuring power management:
# AI_MONITOR_WAKE_MAC=02:00:00:00:00:01
# AI_MONITOR_WAKE_BROADCAST=192.0.2.255
