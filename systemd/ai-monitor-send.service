[Unit]
Description=Deliver the prepared digest via Gmail
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=ai-monitor
Group=ai-monitor
WorkingDirectory=/var/lib/ai-monitor
Environment=PYTHONUNBUFFERED=1
UMask=0077
ExecStart=/usr/bin/python3 -I /opt/ai-monitor/run.py daily_job send
TimeoutStartSec=3min
NoNewPrivileges=true
