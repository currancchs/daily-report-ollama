[Unit]
Description=Private AI log report and suppression controls
After=network.target

[Service]
Type=simple
User=ai-monitor
Group=ai-monitor
WorkingDirectory=/opt/ai-monitor
UMask=0077
Environment=PYTHONNOUSERSITE=1
EnvironmentFile=/etc/ai-monitor/monitor.env
ExecStart=/opt/ai-monitor-web-venv/bin/gunicorn --chdir /opt/ai-monitor --bind 127.0.0.1:8767 --workers 2 --threads 2 --timeout 30 --max-requests 500 --max-requests-jitter 50 --error-logfile - report_web:create_dispatcher()
Restart=on-failure
RestartSec=5
TimeoutStopSec=35
MemoryMax=512M
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_UNIX
ReadWritePaths=/var/lib/ai-monitor/suppressions
InaccessiblePaths=/etc/ai-monitor -/var/lib/ai-monitor/events.sqlite -/var/lib/ai-monitor/events.sqlite-wal -/var/lib/ai-monitor/events.sqlite-shm -/var/lib/ai-monitor/cache

[Install]
WantedBy=multi-user.target
